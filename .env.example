# LocalTwitter runtime settings. Copy this file to .env for local tooling only;
# the Go server reads its configuration from the process environment.
LOCALTWITTER_ADDR=:8080
LOCALTWITTER_CONFIG=localtwitter.config.json
LOCALTWITTER_DB_DIR=.
# LOCALTWITTER_WEB_DIR=web/dist
# LOCALTWITTER_ACCESS_LOG=logs/access.log

# Optional downloader integration. Never put cookies, auth tokens, or proxy
# credentials in this file; configure them in the running application's settings.
# LOCALTWITTER_DOWNLOADER=/absolute/path/to/start_download.sh

# Optional fnOS Playwright deployment settings. The storage state contains an
# authenticated browser session and must remain local and untracked.
# FNOS_WEB_URL=http://fnos-host:5666
# LOCALTWITTER_VERIFY_URL=http://fnos-host:8083
# FNOS_STORAGE_STATE=.local/fnos/storage-state.json
# FNOS_DEPLOY_TIMEOUT_MS=120000
