#!/bin/bash
set -euo pipefail

APP_ROOT="${TRIM_APPDEST:-$(cd "$(dirname "$0")/.." && pwd)}"
VAR_DIR="${TRIM_PKGVAR:-$APP_ROOT/var}"
TMP_DIR="${TRIM_PKGTMP:-$APP_ROOT/tmp}"
ACCESS_LOG="$VAR_DIR/logs/access.log"
PORT="${wizard_app_port:-${TRIM_SERVICE_PORT:-8080}}"
PID_FILE="$TMP_DIR/localtwitter.pid"
LOG_FILE="$TMP_DIR/localtwitter.log"
BIN="$APP_ROOT/localtwitter"
if [ ! -x "$BIN" ] && [ -x "$APP_ROOT/app/localtwitter" ]; then
  BIN="$APP_ROOT/app/localtwitter"
fi

write_error() {
  local message="$1"
  echo "$message" >&2
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    echo "$message" > "$TRIM_TEMP_LOGFILE"
  fi
}

is_running() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  pgrep -f "$BIN" >/dev/null 2>&1
}

case "${1:-}" in
  start)
    mkdir -p "$VAR_DIR" "$TMP_DIR" "$(dirname "$ACCESS_LOG")"
    if is_running; then
      exit 0
    fi
    if [ ! -x "$BIN" ]; then
      write_error "LocalTwitter binary not found or not executable: $BIN"
      exit 1
    fi
    cd "$APP_ROOT"
    env \
      LOCALTWITTER_ADDR=":$PORT" \
      LOCALTWITTER_CONFIG="$VAR_DIR/localtwitter.config.json" \
      LOCALTWITTER_DB_DIR="$VAR_DIR" \
      LOCALTWITTER_ACCESS_LOG="$ACCESS_LOG" \
      "$BIN" >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
    exit 0
    ;;
  stop)
    if [ -f "$PID_FILE" ]; then
      pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        for _ in $(seq 1 20); do
          if ! kill -0 "$pid" 2>/dev/null; then
            break
          fi
          sleep 0.2
        done
        if kill -0 "$pid" 2>/dev/null; then
          kill -9 "$pid" 2>/dev/null || true
        fi
      fi
      rm -f "$PID_FILE"
    fi
    pkill -f "$BIN" >/dev/null 2>&1 || true
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    write_error "Usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
